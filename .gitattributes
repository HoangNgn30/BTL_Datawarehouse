# Automatically detect text files
* text=auto

# Python
*.py text eol=lf

# JavaScript / TypeScript
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf

# SQL
*.sql text eol=lf

# JSON
*.json text eol=lf

# Markdown
*.md text eol=lf

# Web
*.html text eol=lf
*.css text eol=lf

# Shell scripts
*.sh text eol=lf

# Windows scripts
*.bat text eol=crlf
*.cmd text eol=crlf